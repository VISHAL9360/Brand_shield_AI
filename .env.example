# ==============================================================================
# BrandShield AI - Production & Development Environment Configuration
# ==============================================================================

# Application Environment (development, staging, production, test)
ENVIRONMENT=development
PROJECT_NAME="BrandShield AI"
DEBUG=false
API_V1_PREFIX=/api/v1

# Security & Cryptographic Tokens
SECRET_KEY=09d25e094faa6ca2556c818166b7a9563b93f7099f6f0f4caa6cf63b88e8d3e7
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
HASH_CHAIN_SALT=b5a8370d9e2948bb8f0b7305988147d3
WEBHOOK_SECRET_KEY=brandshield-webhook-production-key-2026

# ==============================================================================
# Database Configuration (PostgreSQL 16+ with pgvector / Cloud / Local)
# ==============================================================================

# Option 1: Dedicated Local PostgreSQL Server (Port 5433 or 5432)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/brandshield_ai

# Option 2: Docker Container (Official pgvector/pgvector:pg16)
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/brandshield_ai

# Option 3: Standard Local PostgreSQL Service (Port 5432)
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/brandshield

# Option 4: Neon / Supabase / Render Cloud PostgreSQL (auto-mapped to ssl=require)
# DATABASE_URL=postgresql://brandshield_owner:secret@ep-cool-fog-1234.us-east-2.aws.neon.tech/brandshield_ai?sslmode=require

# Option 5: Zero-Config Local SQLite Fallback (Automated fallback for dev & CI)
# DATABASE_URL=sqlite+aiosqlite:///./brandshield_local.db

# Database Connection Pool Tuning
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30.0
DB_POOL_RECYCLE=1800
DB_ECHO=false

# Redis Cache & Rate Limiting
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL_SECONDS=3600

# RAG & Semantic Verification
EMBEDDING_DIMENSION=1536
RRF_K_PARAMETER=60
VECTOR_SIMILARITY_THRESHOLD=0.82

# AI Privacy Gate & Safeguards
EXTERNAL_LLM_TIMEOUT_SECONDS=0.5
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_TIME=30
STOCHASTIC_AUDIT_PROBABILITY=0.05
